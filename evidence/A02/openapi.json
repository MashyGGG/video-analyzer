  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "采集未完成，请上传获授权的 MP4/MOV 文件。"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "ErrorBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "source_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source Id"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Asset Id"
          },
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "state": {
            "type": "string",
            "enum": [
              "RESOLVED",
              "PENDING",
              "ACQUIRING",
              "PROBING",
              "SUCCEEDED",
              "FAILED_PERMANENT"
            ],
            "title": "State"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "validation": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "object",
            "title": "Validation"
          },
          "fallback": {
            "type": "string",
            "const": "upload",
            "title": "Fallback",
            "default": "upload"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "asset_id",
          "job_id",
          "platform",
          "state",
          "attempts"
        ],
        "title": "Job"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "dependencies": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Dependencies"
          },
          "models": {
            "type": "string",
            "title": "Models",
            "default": "not_configured"
          }
        },
        "type": "object",
        "required": [
          "status",
          "code",
          "dependencies"
        ],
        "title": "Readiness"
      },
      "ResolveRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Text"
          },
          "authorized": {
            "type": "boolean",
            "const": true,
            "title": "Authorized"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "authorized"
        ],
        "title": "ResolveRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
